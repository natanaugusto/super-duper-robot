{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "jest"],
    "paths": {
      "@": ["./src"],
      "@db": ["./prisma"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
